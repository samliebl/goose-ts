{
  "name": "goose-ts",
  "version": "0.2.0",
  "description": "A modern TypeScript port of python-goose — extracts article text, main image, metadata, and more from web pages",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Sam Liebl",
  "homepage": "https://github.com/samliebl/goose-ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samliebl/goose-ts.git"
  },
  "keywords": [
    "article extraction",
    "content extraction",
    "html",
    "scraping",
    "readability",
    "goose",
    "unfluff"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "goose-ts": "dist/cli.js"
  },
  "files": [
    "dist",
    "src/resources",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "web": "tsx --env-file-if-exists=.env web/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test web",
    "format": "prettier --write .",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "chardet": "^2.0.0",
    "cheerio": "^1.0.0",
    "dom-serializer": "^2.0.0",
    "domhandler": "^5.0.3",
    "domutils": "^3.2.2",
    "html-entities": "^2.5.2",
    "iconv-lite": "^0.6.3",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "eslint": "^9.39.5",
    "express": "^5.2.1",
    "globals": "^17.11.0",
    "prettier": "^3.4.2",
    "resend": "^6.30.0",
    "tsup": "^8.3.5",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=18.17"
  }
}
