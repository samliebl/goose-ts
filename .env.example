# Copy to .env. Everything here has a working default for local dev
# except OWNER_EMAIL and RESEND_API_KEY.

PORT=4173
HOST=127.0.0.1

# Your own email -- the only account with access until you add more via
# /admin. Also where login notifications go.
OWNER_EMAIL=

# Signs the session cookie. Falls back to an insecure placeholder in local
# dev; must be set to something random in production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Email, via https://resend.com -- needed to actually send sign-in links.
# Without a key, links are written to the server log instead, which is
# fine locally and refused outright when NODE_ENV=production.
RESEND_API_KEY=
RESEND_FROM=regoose <send@send.regoose.com>

# Where the allowlist/login-token JSON store lives. The local default is
# fine for dev; production points this at the Fly volume mount instead
# (already set in fly.toml's [env], not needed here).
# DB_PATH=web/.data/goose-ts.json
